# SPDX-License-Identifier: BSD-3-Clause
[Unit]
Description=NiaOS internal root preparation
BindsTo=var-lib-niaos-roots.mount
After=var-lib-niaos-roots.mount
Requires=niaos-root-preparation.socket niaos-root-bank-check.service
After=niaos-root-bank-check.service
AssertPathExists=/etc/niaos/root-preparation.json
AssertPathExists=/var/lib/niaos/roots/bank.json
AssertPathExists=/var/lib/niaos/roots/bank.lock
AssertPathExists=/var/lib/niaos/core/store/store.lock

[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/libexec/niaos/root_bank.py --config /etc/niaos/root-preparation.json
UMask=0077
Restart=no
KillMode=control-group
OOMPolicy=kill
TimeoutStopSec=15
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_FSETID CAP_MKNOD CAP_SETFCAP CAP_SYS_CHROOT
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/niaos/roots
ReadOnlyPaths=/var/lib/niaos/core
TemporaryFileSystem=/tmp:ro /var/tmp:ro
BindReadOnlyPaths=/usr/lib/niaos/root-preparation/dev:/dev /dev/null /dev/zero /dev/random /dev/urandom
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes
LimitCORE=0
LimitNOFILE=64
MemoryMax=1G
MemorySwapMax=0
CPUQuota=100%
TasksMax=32
