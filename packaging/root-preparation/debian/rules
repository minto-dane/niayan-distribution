#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-3-Clause
export DEB_BUILD_MAINT_OPTIONS = hardening=+all reproducible=+all
export DEB_CFLAGS_MAINT_APPEND = -ffile-prefix-map=$(CURDIR)=/usr/src/niaos/root-preparation -gno-record-gcc-switches
include /usr/share/dpkg/buildflags.mk
export CFLAGS LDFLAGS
export CPPFLAGS := $(filter-out -D_FORTIFY_SOURCE=%,$(CPPFLAGS))

%:
	dh $@
execute_after_dh_install:
	dh_installsysusers
override_dh_auto_build:
	$(MAKE) -C native/worker BUILD=../../build/native-worker -j1
override_dh_auto_test:
	$(MAKE) -C native/worker BUILD=../../build/native-worker check -j1
	python3 -B -m py_compile native/root_bank.py native/root_freeze.py native/bank_device.py native/storage_bootstrap.py native/root_session.py native/root_session_worker.py native/root_worker_monitor.py native/supply_initialize.py native/operator_guard.py native/native_helper.py native/supply_guard.py native/root_handoff.py native/root_session_client.py native/root_supervisor.py native/plan_consent.py native/management_receiver.py native/management_service.py native/catalog_query.py native/management_result.py native/management_grammar.py native/i18n.py
override_dh_auto_install:
override_dh_fixperms:
	dh_fixperms
	chmod 0600 debian/niaos-root-preparation/etc/niaos/root-preparation.json
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
override_dh_auto_clean:
	$(MAKE) -C native/worker clean
	rm -rf build native/__pycache__
