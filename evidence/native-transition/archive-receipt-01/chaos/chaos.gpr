-- SPDX-License-Identifier: MIT
project Chaos is
   for Languages use ("Ada", "C");
   for Source_Dirs use (".", "/workspace/pkgcore/src", "/workspace/pkgcore/runtime",
      "/workspace/pkgcore/vendor/contracts/src", "/workspace/pkgcore/vendor/contracts/runtime");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("chaos_driver.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatVa", "-gnatwe", "-O1", "-g", "-fPIE", "-fstack-protector-strong");
      for Default_Switches ("C") use ("-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", "-g", "-fPIE", "-fstack-protector-strong", "-D_FORTIFY_SOURCE=3");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-lsodium", "-larchive", "-lz", "-lbz2", "-llzma", "-lzstd", "-pie", "-Wl,-z,relro,-z,now,-z,noexecstack");
   end Linker;
end Chaos;
