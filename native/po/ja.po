#, python-brace-format
msgid "Package file is: {path}"
msgstr "パッケージファイル: {path}"

#, python-brace-format
msgid "Downloaded interim fix: {path}"
msgstr "緊急修正を取得しました: {path}"

msgid "ARCHITECTURE"
msgstr "アーキテクチャ"

msgid ""
"Approve exactly this plan? Type yes to continue; any other answer cancels."
msgstr ""
"この計画を承認しますか？ 続行するには yes と入力してください。それ以外は取り"
"消します。"

msgid "Plan cancelled; no confirmation was granted."
msgstr "計画を取り消しました。同意は与えられていません。"

msgid "The request outcome is unconfirmed. No automatic retry was performed."
msgstr "要求の結果を確認できません。自動再試行は行っていません。"

msgid "The native package service is unavailable; no request was sent."
msgstr "nativeパッケージサービスを利用できません。要求は送信していません。"

#, python-brace-format
msgid "Diagnostic: {reason}"
msgstr "診断: {reason}"

msgid "Fileset"
msgstr "ファイルセット"

msgid "Level"
msgstr "版"

msgid "State"
msgstr "状態"

msgid "Architecture"
msgstr "アーキテクチャ"

msgid "No packages are recorded in the accepted catalog."
msgstr "確定済みカタログにパッケージは記録されていません。"

msgid "This operation is not connected to native planning and admission. No package change was started."
msgstr "この操作はネイティブの計画・認可処理へ未接続です。パッケージの変更は開始していません。"

msgid "Catalog queries are temporarily limited. No automatic retry was performed."
msgstr "カタログの照会を一時的に制限しています。自動再試行は行っていません。"

msgid "The native catalog query could not complete. No package change was started."
msgstr "ネイティブカタログの照会を完了できませんでした。パッケージの変更は開始していません。"
