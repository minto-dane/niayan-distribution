msgstr "Les TL/SP/ML/PTF d’autres plateformes ne sont pas des identifiants de version de Nia"

msgid "Invalid command option: {option}."
msgstr "Option de commande non valide : {option}."

msgid "Invoke as: {commands}"
msgstr "Exécutez sous la forme : {commands}"

