msgid "-I accepts only installp option flags"
msgstr "-I accepte uniquement les options d’installp"

msgid "-m must be 1, 2 or 3"
msgstr "-m doit valoir 1, 2 ou 3"

msgid "-p requires -k FIX"
msgstr "-p nécessite -k FIX"

