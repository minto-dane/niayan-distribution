msgstr "-r et -m s’excluent mutuellement"

msgid "-s cannot be combined with -x or -w"
msgstr "-s ne peut pas être combiné avec -x ou -w"

msgid "-v does not accept file operands"
msgstr "-v n’accepte pas de fichiers comme opérandes"

msgid "A required file or directory does not exist."
msgstr "Un fichier ou répertoire nécessaire n’existe pas."

msgid "A symbolic link was encountered where an ordinary path is required."
msgstr "Un lien symbolique a été rencontré à la place du chemin ordinaire requis."

