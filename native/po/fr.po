msgid ""
"Approve exactly this plan? Type yes to continue; any other answer cancels."
msgstr ""
"Approuver exactement ce plan ? Saisissez yes pour continuer ; toute autre "
"réponse annule."

msgid "Plan cancelled; no confirmation was granted."
msgstr "Plan annulé ; aucun consentement donné."

msgid "The request outcome is unconfirmed. No automatic retry was performed."
msgstr ""
"Le résultat de la demande est indéterminé. Aucune nouvelle tentative "
"automatique n’a été effectuée."

msgid "The native package service is unavailable; no request was sent."
msgstr ""
"Le service natif de paquets est indisponible ; aucune demande n’a été "
"envoyée."

