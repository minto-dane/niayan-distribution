msgstr "Action de SUMA no admitida"

msgid "unsupported cron field"
msgstr "campo de cron no admitido"

msgid "unsupported installp flags in -I"
msgstr "opciones de installp no admitidas en -I"

msgid "use -k for fix keywords"
msgstr "use -k para las palabras clave de correcciones"

msgid "verbosity must be 1, 2 or 3"
msgstr "el nivel de detalle debe ser 1, 2 o 3"

