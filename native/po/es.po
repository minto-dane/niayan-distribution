msgstr "especifique -d SOURCE"

msgid "specify -d SOURCE, without operands"
msgstr "especifique -d SOURCE, sin operandos"

msgid "specify -d SOURCE, without package operands"
msgstr "especifique -d SOURCE, sin operandos de paquetes"

msgid "specify -e PACKAGE_FILE"
msgstr "especifique -e PACKAGE_FILE"

msgid "specify -x, -w or -s"
msgstr "especifique -x, -w o -s"

msgid "specify exactly one action from {actions}"
msgstr "especifique exactamente una acción de {actions}"

msgid "specify one interim fix label"
msgstr "especifique una etiqueta de corrección provisional"

msgid "specify one interim package with -e or as an operand"
msgstr "especifique un paquete provisional con -e o como operando"

msgid "specify one selector for remove, at most one for list/check"
msgstr "especifique un selector para eliminar y como máximo uno para listar o comprobar"

