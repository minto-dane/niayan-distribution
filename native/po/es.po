msgstr "ARQUITECTURA"

msgid ""
"Approve exactly this plan? Type yes to continue; any other answer cancels."
msgstr ""
"¿Aprobar exactamente este plan? Escriba yes para continuar; cualquier otra "
"respuesta cancela."

msgid "Plan cancelled; no confirmation was granted."
msgstr "Plan cancelado; no se otorgó la confirmación."

msgid "The request outcome is unconfirmed. No automatic retry was performed."
msgstr ""
"El resultado de la solicitud no está confirmado. No se realizó ningún "
"reintento automático."

msgid "The native package service is unavailable; no request was sent."
msgstr ""
"El servicio nativo de paquetes no está disponible; no se envió ninguna "
"solicitud."

#, python-brace-format
msgid "Diagnostic: {reason}"
msgstr "Diagnóstico: {reason}"

