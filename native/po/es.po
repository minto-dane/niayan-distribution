msgstr "Conjunto de archivos"

msgid "Level"
msgstr "Versión"

msgid "State"
msgstr "Estado"

msgid "Architecture"
msgstr "Arquitectura"

msgid "No packages are recorded in the accepted catalog."
msgstr "No hay paquetes registrados en el catálogo confirmado."

msgid "This operation is not connected to native planning and admission. No package change was started."
msgstr "Esta operación aún no está conectada a la planificación y autorización nativas. No se inició ningún cambio de paquetes."

msgid "Catalog queries are temporarily limited. No automatic retry was performed."
msgstr "Las consultas del catálogo están limitadas temporalmente. No se realizó ningún reintento automático."

msgid "The native catalog query could not complete. No package change was started."
msgstr "No se pudo completar la consulta del catálogo nativo. No se inició ningún cambio de paquetes."
