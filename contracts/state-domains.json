{
  "schema": "org.niaos.layout/v2",
  "product": "nia-os",
  "shared_inode_with_live_tree": false,
  "snapshot_is_backup": false,
  "recursive_snapshot_assumed": false,
  "disk_write_authorized": false,
  "catalog_and_files_same_generation": true,
  "entries": [
    {
      "id": "system",
      "path": "/",
      "storage": "xfs",
      "rollback_domain": "system-generation",
      "system_rollback": true,
      "encrypted": true,
      "contents": "signed-system+configuration",
      "writer": "root",
      "volume": "nia-system",
      "mount_required": true,
      "format_allowed": false
    },
    {
      "id": "catalog",
      "path": "/var/lib/nia/catalog",
      "storage": "embedded-in-system",
      "rollback_domain": "system-generation",
      "system_rollback": true,
      "encrypted": true,
      "contents": "ownership+generation",
      "writer": "nia-catalog",
      "volume": "nia-system",
      "mount_required": false,
      "format_allowed": false
    },
    {
      "id": "control",
      "path": "/var/lib/nia/control",
      "storage": "xfs",
      "rollback_domain": "never-system-rollback",
      "system_rollback": false,
      "encrypted": true,
      "contents": "intent+WAL+replay-ledger",
      "writer": "controlcore",
      "volume": "nia-control",
      "mount_required": true,
      "format_allowed": false
    },
    {
      "id": "trust",
      "path": "/var/lib/nia/trust",
      "storage": "xfs",
      "rollback_domain": "never-system-rollback",
      "system_rollback": false,
      "encrypted": true,
      "contents": "revocation+antirollback+acceptance",
      "writer": "assurance",
      "volume": "nia-trust",
      "mount_required": true,
      "format_allowed": false
    },
    {
      "id": "objects",
      "path": "/var/lib/nia/objects",
      "storage": "xfs",
      "rollback_domain": "never-system-rollback",
      "system_rollback": false,
      "encrypted": true,
      "contents": "content-store+recovery-inputs",
      "writer": "pkgcore",
      "volume": "nia-objects",
      "mount_required": true,
      "format_allowed": false
    },
    {
      "id": "secrets",
      "path": "/etc/nia/keys",
      "storage": "xfs",
      "rollback_domain": "never-system-rollback",
      "system_rollback": false,
      "encrypted": true,
      "contents": "node-specific-envelopes",
      "writer": "assurance",
      "volume": "nia-secrets",
      "mount_required": true,
      "format_allowed": false
    },
    {
      "id": "logs",
      "path": "/var/log",
      "storage": "xfs",
      "rollback_domain": "never-system-rollback",
      "system_rollback": false,
      "encrypted": true,
      "contents": "audit+diagnostics",
      "writer": "logging",
      "volume": "nia-logs",
      "mount_required": true,
      "format_allowed": false
    },
    {
      "id": "cache",
      "path": "/var/cache",
      "storage": "xfs",
      "rollback_domain": "rebuildable",
      "system_rollback": false,
      "encrypted": true,
      "contents": "untrusted-discardable-cache",
      "writer": "per-service",
      "volume": "nia-cache",
      "mount_required": true,
      "format_allowed": false
    },
    {
      "id": "data",
      "path": "/srv",
      "storage": "xfs",
      "rollback_domain": "application-recovery-only",
      "system_rollback": false,
      "encrypted": true,
      "contents": "database+application-data",
      "writer": "application",
      "volume": "nia-data",
      "mount_required": true,
      "format_allowed": false
    },
    {
      "id": "home",
      "path": "/home",
      "storage": "xfs",
      "rollback_domain": "user-recovery-only",
      "system_rollback": false,
      "encrypted": true,
      "contents": "user-data",
      "writer": "user",
      "volume": "nia-home",
      "mount_required": true,
      "format_allowed": false
    },
    {
      "id": "esp",
      "path": "/efi",
      "storage": "vfat",
      "rollback_domain": "signed-boot-selection-only",
      "system_rollback": false,
      "encrypted": false,
      "contents": "signed-UKI+signed-loader+signed-rescue",
      "writer": "boot-controller",
      "volume": "nia-esp",
      "mount_required": true,
      "format_allowed": false
    },
    {
      "id": "run",
      "path": "/run",
      "storage": "tmpfs",
      "rollback_domain": "ephemeral",
      "system_rollback": false,
      "encrypted": false,
      "contents": "volatile-runtime",
      "writer": "systemd",
      "volume": "nia-run",
      "mount_required": true,
      "format_allowed": false
    },
    {
      "id": "tmp",
      "path": "/tmp",
      "storage": "tmpfs",
      "rollback_domain": "ephemeral",
      "system_rollback": false,
      "encrypted": false,
      "contents": "bounded-volatile-tmp",
      "writer": "per-process",
      "volume": "nia-tmp",
      "mount_required": true,
      "format_allowed": false
    },
    {
      "id": "vartmp",
      "path": "/var/tmp",
      "storage": "xfs",
      "rollback_domain": "rebuildable",
      "system_rollback": false,
      "encrypted": true,
      "contents": "persistent-bounded-temp",
      "writer": "per-service",
      "volume": "nia-vartmp",
      "mount_required": true,
      "format_allowed": false
    }
  ],
  "filesystem_snapshot_required": false
}
