# Not enabled by this source distribution; read-only, incomplete platform observation.
[Unit]
Description=Nia local host observations (not an execution permit)
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/nia/hostctl inspect
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
TimeoutStartSec=30s
MemoryMax=128M
TasksMax=32
StandardOutput=journal
StandardError=journal
